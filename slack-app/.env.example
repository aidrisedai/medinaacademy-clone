# ──────────────────────────────────────────────────────────────────────────────
# SlackApp Environment Variables
# Copy this to .env and fill in your values.
# NEVER commit .env to git.
# ──────────────────────────────────────────────────────────────────────────────

# ── Firebase (Frontend) ──────────────────────────────────────────────────────
# Get these from: Firebase Console → Project Settings → Your apps → Web app
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123

# ── Firebase (Backend / Admin SDK) ──────────────────────────────────────────
# Get service account from: Firebase Console → Project Settings → Service accounts
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# Either set GOOGLE_APPLICATION_CREDENTIALS to a path, or inline JSON:
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# Alternative: path to service account key file
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json

# ── Backend ──────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ── Google Cloud ─────────────────────────────────────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
